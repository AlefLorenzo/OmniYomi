{
  "name": "omniyomi",
  "version": "1.1.5",
  "description": "Plataforma completa de leitura, gerenciamento e downloads de mangás e manhwas inspirada no Tachidesk e Tachiyomi",
  "main": "desktop/main.cjs",
  "type": "module",
  "scripts": {
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "npm --prefix client run dev",
    "build:client": "npm --prefix client run build",
    "build:server": "tsc",
    "build": "npm run build:client && npm run build:server",
    "cap:build": "npm --prefix client run build && npm --prefix client run cap:sync",
    "cap:sync": "npm --prefix client run cap:sync",
    "cap:open": "npm --prefix client run cap:open",
    "serve:apk": "node scripts/serve-apk.js",
    "serve:apk:download": "node scripts/serve-apk.js --download",
    "start": "tsx server/src/index.ts",
    "test": "tsx test/system.test.ts",
    "desktop:dev": "npm run build && electron .",
    "desktop:smoke": "npm run build && electron . --smoke-test",
    "desktop:dist": "npm run build && electron-builder --win nsis portable --x64 --publish never",
    "setup": "node scripts/setup.mjs",
    "extensions:sync": "node scripts/sync-extensions.mjs",
    "extensions:install-all": "node scripts/install-extensions.mjs",
    "install:windows": "powershell -ExecutionPolicy Bypass -File scripts/install-windows.ps1"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "archiver": "^7.0.1",
    "axios": "^1.8.4",
    "better-sqlite3": "^13.1.1",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "protobufjs": "^8.8.1",
    "ws": "^8.18.1",
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/archiver": "^6.0.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/long": "^4.0.2",
    "@types/node": "^22.13.9",
    "@types/ws": "^8.5.14",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "electron": "^45.3.3",
    "electron-builder": "^26.17.0"
  },
  "build": {
    "appId": "com.omniyomi.desktop",
    "productName": "OmniYomi Desktop",
    "artifactName": "OmniYomi-Desktop-${version}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "dist/**/*",
      "client/dist/**/*",
      "package.json",
      "!**/*.map",
      "!**/test/**",
      "!**/*.md",
      "scripts/runtime-manager.cjs"
    ],
    "asar": true,
    "asarUnpack": [
      "dist/**",
      "client/dist/**",
      "node_modules/**",
      "package.json"
    ],
    "npmRebuild": true,
    "nodeGypRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "OmniYomi-Desktop-${version}-portable-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "AlefLorenzo",
        "repo": "OmniYomi",
        "releaseType": "release"
      }
    ]
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
