# OmniYomi Environment Variables
# Copie este arquivo para .env e configure conforme necessário

# ===========================================
# Servidor
# ===========================================
PORT=4567
NODE_ENV=development

# ===========================================
# Suwayomi (OPCIONAL - apenas para servidor web)
# O Android usa runtime nativo de extensões
# ===========================================
# Habilitar Suwayomi (padrão: true se SUWAYOMI_DIR estiver configurado)
SUWAYOMI_ENABLED=true

# Diretório base do Suwayomi Server
# Windows: C:\caminho\para\Suwayomi-Server-v2.4.2366-windows-x64
# Linux: /opt/Suwayomi-Server-v2.4.2366-linux-x64
SUWAYOMI_DIR=

# Caminho para o Java do Suwayomi (opcional, detecta automaticamente se não definido)
# Windows: C:\caminho\para\Suwayomi\jre\bin\java.exe
# Linux: /opt/Suwayomi/jre/bin/java
SUWAYOMI_JAVA_PATH=

# Caminho para o JAR do Suwayomi (opcional, detecta automaticamente se não definido)
# Windows: C:\caminho\para\Suwayomi\bin\Suwayomi-Server.jar
# Linux: /opt/Suwayomi/bin/Suwayomi-Server.jar
SUWAYOMI_JAR_PATH=

# ===========================================
# Banco de Dados
# ===========================================
# O banco SQLite é criado automaticamente em data/omniyomi.db

# ===========================================
# Extensões
# ===========================================
# Diretório para extensões JavaScript personalizadas
EXTENSIONS_DIR=data/extensions

# ===========================================
# Logs
# ===========================================
LOG_LEVEL=info